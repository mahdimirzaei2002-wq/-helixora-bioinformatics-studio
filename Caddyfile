{$DOMAIN:localhost} {
    encode zstd gzip

    @app path /app/*
    handle @app {
        reverse_proxy app:8501
    }

    handle {
        root * /srv
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
